  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-usage",
    "cordis"
  ],
  "license": "MIT",
  "author": "lmber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limingboGitHub/dsh-my-plugins.git",
    "directory": "packages/dsh-token-usage-stats"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
