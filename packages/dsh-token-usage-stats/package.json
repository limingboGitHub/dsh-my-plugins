{
  "name": "@lmber/dsh-token-usage-stats",
  "version": "0.4.1",
  "description": "Token usage statistics plugin for DeepSeek Harness: records per-call token usage and shows it in a settings page",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-usage",
    "cordis"
  ],
  "license": "MIT",
  "author": "lmber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limingboGitHub/dsh-my-plugins.git",
    "directory": "packages/dsh-token-usage-stats"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "server/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/smoke.mjs",
    "test:integration": "node tests/integration.mjs",
    "start:server": "node server/index.js"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}

