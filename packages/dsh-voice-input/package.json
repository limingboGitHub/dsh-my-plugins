{
  "name": "@lmber/dsh-voice-input",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Voice input for DeepSeek Harness: a composer microphone button that records in the browser and transcribes on the host through Xiaomi MiMo ASR.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@testing-library/react": "^16.1.0",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "voice-input",
    "asr",
    "speech-recognition",
    "mimo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limingboGitHub/dsh-my-plugins.git",
    "directory": "packages/dsh-voice-input"
  }
}
